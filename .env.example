
# ---------- Public (browser-safe) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile → site key
# For local development you can use Cloudflare's test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---------- Server only (secrets) ----------
# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Supabase → Connect → Session pooler (port 5432). Used only by migrations and scripts.
DATABASE_DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# The "secret" key (older projects call it the "service_role" key)
SUPABASE_SECRET_KEY=

# Resend → API Keys. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Deltacon Security Group <noreply@deltacon1.com>"

# Cloudflare Turnstile → secret key
# Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
CRON_SECRET=
